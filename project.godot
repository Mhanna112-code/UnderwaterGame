; Engine configuration file.
config_version=5

[application]

config/name="UnderwaterGame"
config/features=PackedStringArray("4.4", "Forward Plus")
run/main_scene="res://game/world.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
; the web export has to run on WebGL2, so it gets the compatibility renderer.
; Without this the browser build shows a black screen and nobody plays it.
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
